# Ignore everything by default
*

# Allow specific root files
!.gitignore
!README.md
!PianiPiaV6.exe
!Heartopia MIDI V5.2.exe
!build_v8_exe.bat

# Allow GitHub workflows
!.github/
!.github/**

# Allow image and reference directories
!images/
!images/**
!CookingReference/
!CookingReference/**
!SnowReference/
!SnowReference/**
!Tree&Rock&BushReference/
!Tree&Rock&BushReference/**

# Allow V6, V7 and Electron (V8)
!V6/
!V6/**
!V7/
!V7/**
!Electron/
!Electron/**

# Exclude dependencies and build output inside Electron
Electron/node_modules/**
Electron/dist/**
**/node_modules/**
**/dist/**

# Ignore cache, build, temporary, and tool files inside tracked directories
**/__pycache__/**
**/*.pyc
**/*.pyo
**/.kilo/**
**/.agents/**
**/.vscode/**
**/.idea/**