# Ignore everything by default
*

# Allow specific root files
!.gitignore
!README.md
!PianiPiaV6.exe
!build_v8_exe.bat

# Allow GitHub workflows
!.github/
!.github/**

# Allow image and reference directories
!images/
!images/**
!CookingReference/
!CookingReference/**
!SnowReference/
!SnowReference/**
!Tree&Rock&BushReference/
!Tree&Rock&BushReference/**

# Allow V6, V7 and V8-Electron
!V6/
!V6/**
!V7/
!V7/**
!V8-Electron/
!V8-Electron/**

# Exclude dependencies and build output inside V8-Electron
V8-Electron/node_modules/**
V8-Electron/dist/**
V8-Electron/build/**
V8-Electron/engine-dist/**
V8-Electron/engine/**
!V8-Electron/engine/.gitkeep
**/node_modules/**
**/dist/**

# Ignore cache, build, temporary, and tool files inside tracked directories
**/__pycache__/**
**/*.pyc
**/*.pyo
**/.kilo/**
**/.agents/**
**/.vscode/**
**/.idea/**